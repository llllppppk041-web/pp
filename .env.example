# OmniSearch Interstellar v4.0.0 — local-first, optional connected AI
APP_ENV=development
APP_NAME=OmniSearch Interstellar
APP_VERSION=4.0.0
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=
OMNI_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# local_command (default) or openai_compatible
OMNI_AI_PROVIDER=local_command
OMNI_AI_TIMEOUT_SECONDS=180

# Existing custom BitCOS/JSON runner
OMNI_AI_PROTOCOL=oneshot
# OMNI_AI_COMMAND=python /absolute/path/to/your_bitcos_runner.py --model /absolute/path/to/model-file

# Local Microsoft BitNet llama-server or another OpenAI-compatible endpoint
OMNI_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OMNI_OPENAI_MODEL=bitnet
OMNI_OPENAI_API_KEY=

# Optional remote fallback; both flags are required and send learner context remotely
OMNI_AI_FALLBACK=
OMNI_REMOTE_FALLBACK_CONSENT=false

# Optional Firecrawl backend search key
OMNI_FIRECRAWL_API_KEY=

# Optional local TTS
# OMNI_TTS_COMMAND=python /absolute/path/to/your_local_tts_runner.py
OMNI_TTS_TIMEOUT_SECONDS=90
